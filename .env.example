# Copy to .env for local development. Keep secrets out of source control.
NODE_ENV=development
BACKEND_PORT=4000
FRONTEND_ORIGIN=http://127.0.0.1:5173
MONGODB_URI=mongodb://127.0.0.1:27017/fraud-defense
JWT_SECRET=replace-with-a-long-random-local-secret
JWT_EXPIRES_IN=8h
DEMO_USER_EMAIL=analyst@example.local
DEMO_USER_PASSWORD=change-this-demo-password

ML_SERVICE_URL=http://127.0.0.1:8000
AGENTS_SERVICE_URL=http://127.0.0.1:8001
LOW_MAX=0.30
HIGH_MIN=0.80
HIGH_VALUE_THRESHOLD=1000

ML_PROVIDER=local
LLM_PROVIDER=ollama

SIMULATOR_RATE=2
